import React, { useState, useEffect } from 'react';
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  ScrollView,
  ActivityIndicator,
} from 'react-native';
import { supabase } from '../utils/supabase';
import { Ionicons } from '@expo/vector-icons';

export default function Results({ navigation, route }) {
  const { attemptId, score, totalQuestions, correctAnswers, quizTitle } = route.params;
  const [loading, setLoading] = useState(false);
  const [detailedResults, setDetailedResults] = useState([]);

  useEffect(() => {
    fetchDetailedResults();
  }, []);

  const fetchDetailedResults = async () => {
    try {
      const { data } = await supabase
        .from('student_answers')
        .select(`
          *,
          questions (question_text, correct_answer, explanation)
        `)
        .eq('attempt_id', attemptId);

      setDetailedResults(data || []);
    } catch (error) {
      console.error('Error fetching results:', error);
    }
  };

  const getGrade = (score) => {
    if (score >= 80) return { text: 'A', color: '#4CAF50', label: 'Excellent!' };
    if (score >= 70) return { text: 'B', color: '#8BC34A', label: 'Very Good!' };
    if (score >= 60) return { text: 'C', color: '#FFC107', label: 'Good' };
    if (score >= 50) return { text: 'D', color: '#FF9800', label: 'Satisfactory' };
    return { text: 'F', color: '#F44336', label: 'Needs Improvement' };
  };

  const grade = getGrade(score);
  const wrongAnswers = totalQuestions - correctAnswers;

  if (loading) {
    return (
      <View style={styles.loadingContainer}>
        <ActivityIndicator size="large" color="#FF6B00" />
      </View>
    );
  }

  return (
    <ScrollView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.headerTitle}>Quiz Results</Text>
        <Text style={styles.headerSubtitle}>{quizTitle}</Text>
      </View>

      <View style={styles.scoreCard}>
        <View style={styles.scoreCircle}>
          <Text style={styles.scoreNumber}>{score}%</Text>
          <View style={[styles.gradeBadge, { backgroundColor: grade.color + '20' }]}>
            <Text style={[styles.gradeText, { color: grade.color }]}>{grade.text}</Text>
          </View>
        </View>
        <Text style={styles.gradeLabel}>{grade.label}</Text>
      </View>

      <View style={styles.statsContainer}>
        <View style={styles.statItem}>
          <Text style={styles.statNumber}>{correctAnswers}</Text>
          <Text style={styles.statLabel}>Correct</Text>
        </View>
        <View style={styles.statDivider} />
        <View style={styles.statItem}>
          <Text style={[styles.statNumber, { color: '#F44336' }]}>{wrongAnswers}</Text>
          <Text style={styles.statLabel}>Wrong</Text>
        </View>
        <View style={styles.statDivider} />
        <View style={styles.statItem}>
          <Text style={styles.statNumber}>{totalQuestions}</Text>
          <Text style={styles.statLabel}>Total</Text>
        </View>
      </View>

      <View style={styles.actionsContainer}>
        <TouchableOpacity
          style={styles.retryButton}
          onPress={() => navigation.navigate('Quizzes')}
        >
          <Ionicons name="refresh" size={20} color="#FF6B00" />
          <Text style={styles.retryButtonText}>Try Another Quiz</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.homeButton}
          onPress={() => navigation.navigate('Home')}
        >
          <Ionicons name="home" size={20} color="#fff" />
          <Text style={styles.homeButtonText}>Go Home</Text>
        </TouchableOpacity>
      </View>

      {detailedResults.length > 0 && (
        <View style={styles.detailedContainer}>
          <Text style={styles.detailedTitle}>Detailed Review</Text>
          {detailedResults.map((item, index) => (
            <View key={index} style={styles.reviewItem}>
              <View style={styles.reviewHeader}>
                <Text style={styles.reviewNumber}>Q{index + 1}</Text>
                <View style={[
                  styles.reviewStatus,
                  { backgroundColor: item.is_correct ? '#4CAF5020' : '#F4433620' }
                ]}>
                  <Text style={[
                    styles.reviewStatusText,
                    { color: item.is_correct ? '#4CAF50' : '#F44336' }
                  ]}>
                    {item.is_correct ? 'Correct' : 'Incorrect'}
                  </Text>
                </View>
              </View>
              <Text style={styles.reviewQuestion}>{item.questions?.question_text}</Text>
              <Text style={styles.reviewAnswer}>
                Your answer: {item.selected_answer || 'Not answered'}
              </Text>
              {!item.is_correct && (
                <Text style={styles.reviewCorrect}>
                  Correct answer: {item.questions?.correct_answer}
                </Text>
              )}
              {item.questions?.explanation && (
                <Text style={styles.reviewExplanation}>
                  Explanation: {item.questions.explanation}
                </Text>
              )}
            </View>
          ))}
        </View>
      )}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#f8f9fa',
  },
  loadingContainer: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
  },
  header: {
    backgroundColor: '#FF6B00',
    padding: 30,
    paddingTop: 40,
    alignItems: 'center',
  },
  headerTitle: {
    fontSize: 24,
    fontWeight: 'bold',
    color: '#fff',
  },
  headerSubtitle: {
    fontSize: 16,
    color: 'rgba(255,255,255,0.8)',
    marginTop: 5,
  },
  scoreCard: {
    backgroundColor: '#fff',
    margin: 20,
    padding: 30,
    borderRadius: 15,
    alignItems: 'center',
    elevation: 2,
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 4,
  },
  scoreCircle: {
    alignItems: 'center',
  },
  scoreNumber: {
    fontSize: 48,
    fontWeight: 'bold',
    color: '#FF6B00',
  },
  gradeBadge: {
    paddingHorizontal: 20,
    paddingVertical: 5,
    borderRadius: 12,
    marginTop: 10,
  },
  gradeText: {
    fontSize: 18,
    fontWeight: 'bold',
  },
  gradeLabel: {
    fontSize: 16,
    color: '#666',
    marginTop: 10,
  },
  statsContainer: {
    flexDirection: 'row',
    backgroundColor: '#fff',
    marginHorizontal: 20,
    padding: 20,
    borderRadius: 15,
    elevation: 2,
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 4,
  },
  statItem: {
    flex: 1,
    alignItems: 'center',
  },
  statNumber: {
    fontSize: 24,
    fontWeight: 'bold',
    color: '#333',
  },
  statLabel: {
    fontSize: 14,
    color: '#666',
    marginTop: 5,
  },
  statDivider: {
    width: 1,
    backgroundColor: '#e0e0e0',
  },
  actionsContainer: {
    padding: 20,
  },
  retryButton: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    padding: 15,
    borderRadius: 10,
    borderWidth: 1,
    borderColor: '#FF6B00',
    marginBottom: 10,
  },
  retryButtonText: {
    fontSize: 16,
    fontWeight: 'bold',
    color: '#FF6B00',
    marginLeft: 10,
  },
  homeButton: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    padding: 15,
    borderRadius: 10,
    backgroundColor: '#FF6B00',
  },
  homeButtonText: {
    fontSize: 16,
    fontWeight: 'bold',
    color: '#fff',
    marginLeft: 10,
  },
  detailedContainer: {
    padding: 20,
  },
  detailedTitle: {
    fontSize: 18,
    fontWeight: 'bold',
    color: '#333',
    marginBottom: 15,
  },
  reviewItem: {
    backgroundColor: '#fff',
    borderRadius: 10,
    padding: 15,
    marginBottom: 10,
  },
  reviewHeader: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: 10,
  },
  reviewNumber: {
    fontSize: 14,
    fontWeight: 'bold',
    color: '#333',
  },
  reviewStatus: {
    paddingHorizontal: 12,
    paddingVertical: 4,
    borderRadius: 12,
  },
  reviewStatusText: {
    fontSize: 12,
    fontWeight: 'bold',
  },
  reviewQuestion: {
    fontSize: 16,
    color: '#333',
    marginBottom: 5,
  },
  reviewAnswer: {
    fontSize: 14,
    color: '#666',
    marginBottom: 3,
  },
  reviewCorrect: {
    fontSize: 14,
    color: '#4CAF50',
    marginBottom: 3,
  },
  reviewExplanation: {
    fontSize: 14,
    color: '#666',
    fontStyle: 'italic',
    marginTop: 5,
  },
});