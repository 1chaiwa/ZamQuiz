import React from 'react';
import ReactDOM from 'react-dom/client';
import './index.css';
import App from './App';
import { HashRouter } from 'react-router-dom';

// HashRouter (not BrowserRouter) on purpose: GitHub Pages serves static files
// with no server-side rewrite rule, so a "real" path like /ZamQuiz/quizzes
// would 404 on refresh or direct link. HashRouter keeps all routing in the
// URL fragment (e.g. /ZamQuiz/#/quizzes), which always resolves to
// index.html regardless of what comes after the #.
const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(
  <React.StrictMode>
    <HashRouter>
      <App />
    </HashRouter>
  </React.StrictMode>
);
